# visit https://giscus.app to get your Giscus ids
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_UTTERANCES_REPO=
NEXT_PUBLIC_DISQUS_SHORTNAME=


MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

BUTTONDOWN_API_KEY=

CONVERTKIT_API_KEY=
# curl https://api.convertkit.com/v3/forms?api_key=<your_public_api_key> to get your form ID
CONVERTKIT_FORM_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

REVUE_API_KEY=

# Create EmailOctopus API key at https://emailoctopus.com/api-documentation
EMAILOCTOPUS_API_KEY=
# List ID can be found in the URL as a UUID after clicking a list on https://emailoctopus.com/lists
# or the settings page of your list https://emailoctopus.com/lists/{UUID}/settings
EMAILOCTOPUS_LIST_ID=

# Create Beehiiv API key at https://developers.beehiiv.com/docs/v2/bktd9a7mxo67n-create-an-api-key
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth & Calendar (REQUIRED)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your-oauth-secret
GOOGLE_OAUTH_REFRESH=your-refresh-token
GOOGLE_MAPS_API_KEY=your-maps-api-key
GOOGLE_MAPS_CAL_PRIMARY_EVENT_ID=your-calendar-event-id

# Business Owner Information (REQUIRED)
OWNER_EMAIL=your-email@example.com
OWNER_NAME=Your Name
OWNER_PHONE_NUMBER=+1234567890

# Site Configuration (REQUIRED)
NEXT_PUBLIC_SITE_URL=https://your-site.com

# Playwright E2E Testing
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Debug Logging (set to 'true' to enable verbose proxy logging)
PROXY_DEBUG=

# Calendar Mock Data (set to 'true' to use mock calendar data instead of Google Calendar API)
USE_MOCK_CALENDAR_DATA=

# Optional Features
ADMIN_EMAILS=admin@example.com,admin2@example.com
PUSHOVER_API_KEY=
PUSHOVER_USER_KEY=
NEXT_PUBLIC_DISABLE_POSTHOG=false
COOKIE_DOMAIN=
NEXTAUTH_URL=
CAPTURE_TEST_DATA=false

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Secret key for encoding/decoding SMS ref tracking codes (scripts/ref-code.ts)
NEXT_PUBLIC_REF_CODE_SECRET=generate-with-openssl-rand-base64-24

# --- Server-side referral person-tagging (lib/ref, /api/ref) ---
# Query param carrying the opaque ref token (client + server). Default: ref
NEXT_PUBLIC_REF_PARAM=ref
# PostHog ingest host for server capture (posthog-node). No default in code.
POSTHOG_HOST=https://us.i.posthog.com
# Optional server-only overrides (defaults shown):
#   REF_CODE_SECRET=            # server obfuscation secret (falls back to NEXT_PUBLIC_REF_CODE_SECRET)
#   REF_PROP_REFERRED_BY=referred_by
#   REF_PROP_TOKEN=ref_token
#   REF_EVENT=referral_tagged
#   REF_TAG_FALLBACK=defer      # or `generate` (captures on a throwaway id)
#   POSTHOG_ENV=                # force dev|prod (default: NODE_ENV; route derives from host)
# Live integration test ONLY — dev instance readback via the Persons API.
# Leave blank to skip the live test. NEVER point these at prod.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID_DEV=
# Optional: app host for the Persons API (default: POSTHOG_HOST with `i.` stripped)
POSTHOG_API_HOST=
